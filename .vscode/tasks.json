{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Milton",
      "type": "shell",
      "command": "${workspaceFolder}\\build.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "base": "$msCompile",
        "fileLocation": [
          "relative",
          "${workspaceFolder}\\build"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
